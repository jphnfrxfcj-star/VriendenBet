# Netlify site environment variables for MielBet.
# Copy these keys to Netlify UI, or create a local ignored `netlify.env`
# with real values and import it with Netlify CLI.
#
# Required scopes in Netlify UI:
# - DATABASE_URL: Builds + Functions
# - SESSION_SECRET: Functions
# - SEED_PIN: Builds, and Functions only if demo fallback is intentionally enabled
# - LOGIN_RATE_LIMIT_*: Functions
# - ALLOW_DEMO_LOGIN: Functions
#
# Do not commit real values.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"
SESSION_SECRET="replace-with-a-generated-secret-of-at-least-32-characters"
SEED_PIN="replace-with-private-production-pin"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="8"
ALLOW_DEMO_LOGIN="false"
